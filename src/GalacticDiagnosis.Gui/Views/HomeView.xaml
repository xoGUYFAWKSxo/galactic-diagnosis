<UserControl x:Class="GalacticDiagnosis.Gui.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <Image Source="/Assets/icon.png" Width="128" Height="128" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Galactic Diagnosis" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,18,0,6" />
            <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center"
                       Text="Plain-English health reports for this PC. Open a saved report to view it here." />
            <Button Style="{StaticResource PrimaryButton}" Content="Open a saved report" HorizontalAlignment="Center" Margin="0,22,0,0"
                    Command="{Binding Main.OpenReportCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
