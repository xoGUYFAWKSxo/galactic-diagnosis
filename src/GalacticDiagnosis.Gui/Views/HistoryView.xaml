<UserControl x:Class="GalacticDiagnosis.Gui.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GalacticDiagnosis.Gui">
    <UserControl.Resources>
        <local:VisibleWhen x:Key="Visible" />
        <local:VisibleWhen x:Key="Hidden" Invert="True" />
        <Style x:Key="Col" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="HeadCol" TargetType="TextBlock" BasedOn="{StaticResource Col}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="24,20,24,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid DockPanel.Dock="Right" Width="280" Margin="16,0,0,0" VerticalAlignment="Bottom">
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search"
                         Padding="30,6,8,6" ToolTip="Search by customer, job number, computer or date" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Muted}"
                           VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                <TextBlock Text="Search customer, job, computer" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                           Margin="31,0,0,0" IsHitTestVisible="False"
                           Visibility="{Binding Search, Converter={StaticResource Hidden}}" />
            </Grid>
            <StackPanel>
                <TextBlock Text="History" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}">
                    <Run Text="{Binding CountText, Mode=OneWay}" /><Run Text=" in the Reports folder next to the tool" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Open" Command="{Binding OpenCommand}" AutomationProperties.Name="Open selected" />
            <Button Content="Compare the two selected" Margin="10,0,0,0" Command="{Binding CompareCommand}" AutomationProperties.Name="Compare selected" />
            <Button Style="{StaticResource QuietButton}" Content="Show in folder" Margin="10,0,0,0" Command="{Binding ShowInFolderCommand}" />
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"
                       Text="Ctrl+click to select two checks, then compare them. The older one counts as before." />
        </StackPanel>

        <Grid>
        <Border Style="{StaticResource Card}" Padding="16,10" Visibility="{Binding IsEmpty, Converter={StaticResource Hidden}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,0,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CUSTOMER" Style="{StaticResource HeadCol}" />
                    <TextBlock Grid.Column="1" Text="JOB" Style="{StaticResource HeadCol}" />
                    <TextBlock Grid.Column="2" Text="DATE" Style="{StaticResource HeadCol}" />
                    <TextBlock Grid.Column="3" Text="CHECK" Style="{StaticResource HeadCol}" />
                    <TextBlock Grid.Column="4" Text="COMPUTER" Style="{StaticResource HeadCol}" />
                    <TextBlock Grid.Column="5" Text="OVERALL" Style="{StaticResource HeadCol}" />
                </Grid>
                <ListBox x:Name="List" Style="{StaticResource PickList}" ItemsSource="{Binding Rows}" SelectionMode="Extended"
                         SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick"
                         AutomationProperties.Name="Saved checks">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Customer}" FontWeight="SemiBold" Style="{StaticResource Col}" />
                                <TextBlock Grid.Column="1" Text="{Binding Job}" Style="{StaticResource Col}" />
                                <TextBlock Grid.Column="2" Text="{Binding Date}" Style="{StaticResource Col}" />
                                <TextBlock Grid.Column="3" Text="{Binding Type}" Style="{StaticResource Col}" />
                                <TextBlock Grid.Column="4" Text="{Binding Machine}" Style="{StaticResource Col}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource VerdictDot}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource VerdictText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource MutedText}" Text="No saved checks yet. Finished checks are saved to the Reports folder next to the tool and show up here." />
        </Border>
        </Grid>
    </DockPanel>
</UserControl>
