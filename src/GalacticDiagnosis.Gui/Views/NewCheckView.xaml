<UserControl x:Class="GalacticDiagnosis.Gui.Views.NewCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GalacticDiagnosis.Gui">
    <UserControl.Resources>
        <local:VisibleWhen x:Key="Visible" />
        <local:VisibleWhen x:Key="Hidden" Invert="True" />
        <Style x:Key="Multiline" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="MaxHeight" Value="160" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="24,24,24,32">
            <DockPanel Margin="0,0,0,16">
                <Image DockPanel.Dock="Left" Source="/Assets/icon.png" Width="64" Height="64" Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="New check" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Fill in the details, then start. The check takes about a minute and only reads from this PC; it changes nothing." />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14" BorderBrush="{DynamicResource Alert}"
                    Visibility="{Binding Main.IsAdmin, Converter={StaticResource Hidden}}">
                <StackPanel>
                    <TextBlock Text="Not running as administrator" FontWeight="SemiBold" Foreground="{DynamicResource Alert}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="Drive health, startup time and some event logs will be missing. Close the tool, right-click it and choose Run as administrator for a full report." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Customer name" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <TextBox x:Name="CustomerBox" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Customer name" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Job number (optional)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding JobNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Job number" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Checked by (optional, remembered)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding TechnicianName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Checked by" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Check type" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Before service" GroupName="RunType"
                                     IsChecked="{Binding IsBefore}" AutomationProperties.Name="Before service" />
                        <RadioButton Style="{StaticResource Segment}" Content="After service" GroupName="RunType"
                                     IsChecked="{Binding IsAfter}" AutomationProperties.Name="After service" />
                    </StackPanel>

                    <!-- Before: what the customer reported -->
                    <StackPanel Visibility="{Binding IsBefore, Converter={StaticResource Visible}}">
                        <TextBlock Text="Problem the customer reported" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource Multiline}" Text="{Binding Complaint, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Problem the customer reported" />
                    </StackPanel>

                    <!-- After: pick the before check, then say what was done -->
                    <StackPanel Visibility="{Binding IsAfter, Converter={StaticResource Visible}}">
                        <DockPanel Margin="0,14,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="6,2" FontSize="12"
                                    Content="Don't compare" Command="{Binding NoComparisonCommand}"
                                    Visibility="{Binding HasBeforeRuns, Converter={StaticResource Visible}}" />
                            <TextBlock Text="Compare with the before check" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox Style="{StaticResource PickList}" ItemsSource="{Binding BeforeRuns}" SelectedItem="{Binding SelectedBefore}"
                                 MaxHeight="210" AutomationProperties.Name="Before checks"
                                 Visibility="{Binding HasBeforeRuns, Converter={StaticResource Visible}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding Run.Intake.CustomerName, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="  ·  " Foreground="{DynamicResource Muted}" />
                                            <Run Text="{Binding Run.StartedAt, Mode=OneWay, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Run.Intake.Complaint}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding CompareNote}" FontSize="13" />

                        <TextBlock Text="What was done" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource Multiline}" Text="{Binding WorkDone, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="What was done" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" IsDefault="False"
                        AutomationProperties.Name="Start check">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Start check" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuietButton}" Content="Open a saved report" Margin="12,0,0,0"
                        Command="{Binding Main.OpenReportCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
