<UserControl x:Class="GalacticDiagnosis.Gui.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:GalacticDiagnosis.Gui">
    <UserControl.Resources>
        <local:VisibleWhen x:Key="Visible" />
        <local:VisibleWhen x:Key="Hidden" Invert="True" />
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Multiline" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="MaxHeight" Value="140" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- Toolbar: page tabs on the left, actions on the right. -->
        <Border DockPanel.Dock="Top" Padding="18,12,18,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,10"
                           TextTrimming="CharacterEllipsis" />
                <ListBox DockPanel.Dock="Left" Style="{StaticResource SegmentList}" ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding Selected}" DisplayMemberPath="Header" AutomationProperties.Name="Report pages"
                         VerticalAlignment="Top" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Command="{Binding StartEditCommand}" Margin="8,0,0,4" ToolTip="Change the notes on this check"
                            Visibility="{Binding CanEditNotes, Converter={StaticResource Visible}}" AutomationProperties.Name="Edit notes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Edit notes" />
                        </StackPanel>
                    </Button>
                    <Button Click="SavePdf_Click" Margin="8,0,0,4" ToolTip="Save this page as a PDF"
                            Visibility="{Binding CanPdf, Converter={StaticResource Visible}}" AutomationProperties.Name="Save as PDF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA90;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Save as PDF" />
                        </StackPanel>
                    </Button>
                    <Button Click="LeaveCopy_Click" Margin="8,0,0,4"
                            ToolTip="Save the customer summary (and before/after page) as PDFs on this PC's Desktop"
                            Visibility="{Binding CanLeaveCopy, Converter={StaticResource Visible}}" AutomationProperties.Name="Leave a copy for the customer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Leave a copy" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CopySummaryCommand}" Margin="8,0,0,4" ToolTip="Copy a plain-text summary for an invoice, ticket or message"
                            Visibility="{Binding CanCopySummary, Converter={StaticResource Visible}}" AutomationProperties.Name="Copy summary">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Copy summary" />
                        </StackPanel>
                    </Button>
                    <ToggleButton IsChecked="{Binding ShowFixPanel}" Margin="8,0,0,4" Style="{StaticResource ToggleChip}"
                                  ToolTip="Show or hide shortcuts to the Windows tools that fix these findings"
                                  Visibility="{Binding HasFixItems, Converter={StaticResource Visible}}" AutomationProperties.Name="Fix it">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource IconText}" />
                            <TextBlock Text="Fix it" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Command="{Binding OpenInBrowserCommand}" Margin="8,0,0,4" Padding="10,7" ToolTip="Open this page in the web browser"
                            AutomationProperties.Name="Open in browser">
                        <TextBlock Text="&#xE774;" Style="{StaticResource IconText}" Margin="0" />
                    </Button>
                    <Button Command="{Binding ShowInFolderCommand}" Margin="8,0,0,4" Padding="10,7" ToolTip="Show the saved files in Explorer"
                            AutomationProperties.Name="Show in folder">
                        <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" Margin="0" />
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Edit notes -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="18,0,18,12"
                Visibility="{Binding IsEditing, Converter={StaticResource Visible}}">
            <StackPanel>
                <StackPanel Visibility="{Binding IsAfterRun, Converter={StaticResource Hidden}}">
                    <TextBlock Text="Problem the customer reported" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource Multiline}" Text="{Binding EditComplaint, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Edit problem" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsAfterRun, Converter={StaticResource Visible}}">
                    <TextBlock Text="What was done" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding EditChecklist.Entries}" ItemTemplate="{StaticResource ChecklistEntryTemplate}"
                                  ItemsPanel="{StaticResource TwoColumns}" Focusable="False" />
                    <TextBlock Text="Other notes" Style="{StaticResource Label}" />
                    <TextBox Style="{StaticResource Multiline}" Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Edit notes text" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Save notes" Command="{Binding SaveNotesCommand}" />
                    <Button Style="{StaticResource QuietButton}" Content="Cancel" Margin="10,0,0,0" Command="{Binding CancelEditCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- No WebView2 runtime: the report opens in the browser instead. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="18,0,18,12"
                Visibility="{Binding WebViewMissing, Converter={StaticResource Visible}}">
            <StackPanel>
                <TextBlock Text="This report opened in your web browser" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                           Text="This PC doesn't have the Microsoft Edge WebView2 runtime, which shows reports inside this window. Nothing is missing from the report itself; use Open in browser to show a page again, and the browser's Print to save a PDF." />
            </StackPanel>
        </Border>

        <!-- Fix it: shortcuts to Windows' own tools, and Check again. Never changes the saved report. -->
        <Border DockPanel.Dock="Right" Width="320" Margin="0,0,18,18" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding ShowFixPanel, Converter={StaticResource Visible}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                    <TextBlock Text="Fix it" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"
                               Text="These open Windows' own tools. This app doesn't change anything; run an after check to show the difference." />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FixItems}" Margin="12,0,12,12" AutomationProperties.Name="Fix it list">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource VerdictDot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource VerdictText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Warning}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding Note, Converter={StaticResource Visible}}" />
                                        <ItemsControl x:Name="ActionList" ItemsSource="{Binding Actions}" Margin="0,6,0,0" Tag="{Binding}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" ToolTip="{Binding ToolTip}" Padding="10,4" FontSize="12" Margin="0,4,6,0"
                                                            Command="{Binding Tag.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource QuietButton}" Padding="0,2" FontSize="12"
                                                    Command="{Binding CheckAgainCommand}" Foreground="{DynamicResource Accent}"
                                                    AutomationProperties.Name="{Binding Title, StringFormat='Check {0} again'}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Check again" />
                                                </StackPanel>
                                            </Button>
                                            <Path Style="{StaticResource Spinner}" Margin="8,0,0,0" Width="12" Height="12"
                                                  Visibility="{Binding Checking, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                        <StackPanel DataContext="{Binding Recheck}" Visibility="{Binding Converter={StaticResource Visible}}" Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource VerdictDot}" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource VerdictText}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Margin="18,0,18,18" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Line}" ClipToBounds="True"
                Visibility="{Binding WebViewMissing, Converter={StaticResource Hidden}}">
            <wv2:WebView2 x:Name="Web" AutomationProperties.Name="Report" />
        </Border>
    </DockPanel>
</UserControl>
