<UserControl x:Class="GalacticDiagnosis.Gui.Views.RunningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GalacticDiagnosis.Gui">
    <UserControl.Resources>
        <local:VisibleWhen x:Key="Visible" />
        <local:VisibleWhen x:Key="Hidden" Invert="True" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" Margin="24,24,24,32">
            <TextBlock Text="{Binding Heading}" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding SubHeading}" Style="{StaticResource MutedText}" />

            <DockPanel Margin="0,18,0,8">
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Muted}">
                    <Run Text="{Binding DoneCount, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding Total, Mode=OneWay}" /><Run Text=" done" />
                </TextBlock>
                <ProgressBar Value="{Binding DoneCount, Mode=OneWay}" Maximum="{Binding Total, Mode=OneWay}" Margin="0,0,16,0"
                             VerticalAlignment="Center" AutomationProperties.Name="Progress" />
            </DockPanel>

            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Checks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource Spinner}" VerticalAlignment="Top" Margin="0,3,0,0"
                                          Visibility="{Binding Done, Converter={StaticResource Hidden}}" />
                                    <Ellipse Style="{StaticResource VerdictDot}" VerticalAlignment="Top" Margin="2,5,0,0" HorizontalAlignment="Left"
                                             Visibility="{Binding Done, Converter={StaticResource Visible}}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource VerdictText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Elapsed}" Foreground="{DynamicResource Muted}" FontSize="12"
                                               Margin="12,2,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Button Content="Cancel" HorizontalAlignment="Left" Margin="0,18,0,0" Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel check" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
