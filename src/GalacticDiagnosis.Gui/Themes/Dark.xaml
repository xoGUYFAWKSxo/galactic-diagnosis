<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Galactic Studio palette, taken from the app icons. -->
    <SolidColorBrush x:Key="Bg" Color="#0C1028" />
    <SolidColorBrush x:Key="Panel" Color="#121A3A" />
    <SolidColorBrush x:Key="PanelAlt" Color="#1A2450" />
    <SolidColorBrush x:Key="Line" Color="#26305A" />
    <SolidColorBrush x:Key="Ink" Color="#ECF2FC" />
    <SolidColorBrush x:Key="Muted" Color="#8C9CB8" />
    <SolidColorBrush x:Key="Accent" Color="#5AE6FF" />
    <SolidColorBrush x:Key="AccentHover" Color="#8CEEFF" />
    <SolidColorBrush x:Key="AccentInk" Color="#0C1028" />
    <SolidColorBrush x:Key="Alert" Color="#FF5C78" />
    <SolidColorBrush x:Key="Good" Color="#5FD49A" />
    <SolidColorBrush x:Key="Warning" Color="#FFC552" />
    <SolidColorBrush x:Key="Bad" Color="#FF7A8E" />
    <SolidColorBrush x:Key="Unavailable" Color="#A3ADC2" />
    <SolidColorBrush x:Key="Info" Color="#8FB0FF" />
    <SolidColorBrush x:Key="Selection" Color="#2A3A78" />
</ResourceDictionary>
