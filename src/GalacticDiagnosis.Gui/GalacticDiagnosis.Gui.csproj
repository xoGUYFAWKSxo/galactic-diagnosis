<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>GalacticDiagnosis</AssemblyName>
    <RootNamespace>GalacticDiagnosis.Gui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\icon.png" Link="Assets\icon.png" />
    <Resource Include="..\..\assets\icon.ico" Link="Assets\icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GalacticDiagnosis.Core\GalacticDiagnosis.Core.csproj" />
    <ProjectReference Include="..\GalacticDiagnosis.Report\GalacticDiagnosis.Report.csproj" />
  </ItemGroup>
</Project>
