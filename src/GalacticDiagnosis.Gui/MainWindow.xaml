<Window x:Class="GalacticDiagnosis.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GalacticDiagnosis.Gui.ViewModels"
        xmlns:v="clr-namespace:GalacticDiagnosis.Gui.Views"
        xmlns:local="clr-namespace:GalacticDiagnosis.Gui"
        Title="Galactic Diagnosis" Width="1180" Height="820" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="/Assets/icon.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:VisibleWhen x:Key="Visible" />
        <local:VisibleWhen x:Key="Hidden" Invert="True" />
        <DataTemplate DataType="{x:Type vm:NewCheckViewModel}"><v:NewCheckView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunningViewModel}"><v:RunningView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}"><v:ReportView /></DataTemplate>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenReportCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCheckCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource QuietButton}" Padding="4" Command="{Binding NewCheckCommand}"
                        ToolTip="New check" AutomationProperties.Name="Home">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/icon.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Galactic Diagnosis" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding MachineName}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border CornerRadius="999" Padding="10,3" Margin="0,0,14,0" VerticalAlignment="Center"
                            BorderThickness="1" BorderBrush="{DynamicResource Good}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource Visible}}"
                            ToolTip="Running as administrator, so every check can run.">
                        <TextBlock Text="Administrator" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Good}" />
                    </Border>
                    <Border CornerRadius="999" Padding="10,3" Margin="0,0,14,0" VerticalAlignment="Center"
                            BorderThickness="1" BorderBrush="{DynamicResource Alert}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource Hidden}}"
                            ToolTip="Drive health, startup time and some event logs need administrator rights.">
                        <TextBlock Text="Not administrator" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Alert}" />
                    </Border>
                    <Button Style="{StaticResource QuietButton}" Command="{Binding NewCheckCommand}" ToolTip="Start a new check (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="New check" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuietButton}" Command="{Binding OpenReportCommand}" ToolTip="Open a saved report (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Open report" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource QuietButton}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="Switch between dark and light" AutomationProperties.Name="Switch theme">
                        <Grid>
                            <TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Visibility="{Binding IsDark, Converter={StaticResource Visible}}" />
                            <TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Visibility="{Binding IsDark, Converter={StaticResource Hidden}}" />
                        </Grid>
                    </Button>
                </StackPanel>
                <Border />  <!-- fills the gap between the two sides -->
            </DockPanel>
        </Border>

        <!-- One-line problem banner -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Alert}" BorderThickness="0,0,0,2"
                Padding="18,8" Visibility="{Binding Error, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Alert}" TextWrapping="Wrap" />
        </Border>

        <ContentControl Content="{Binding Page}" Focusable="False" />
    </DockPanel>
</Window>
